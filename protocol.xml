			<Description>After Startup</Description>
			<Type>poll action</Type>
			<Content>
				<Action>2</Action>
			</Content>
		</Group>
		<Group id="3">
			<Name>pollCounterGroup</Name>
			<Description>Group for updating the poll counter</Description>
			<Type>poll action</Type>
			<Content>
				<Action>3</Action>
			</Content>
		</Group>
	</Groups>

	<Triggers>
